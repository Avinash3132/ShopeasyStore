# Local development
SECRET_KEY=replace-with-a-development-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Production
# Set these on your hosting provider, not in Git.
# SECRET_KEY=generate-a-new-long-random-secret
# DEBUG=False
# ALLOWED_HOSTS=your-domain.example.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional HSTS after HTTPS is confirmed:
# SECURE_HSTS_SECONDS=31536000
